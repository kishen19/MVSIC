"""Defines the Bazel module for HACit."""

module(
    name = "mvsic",
    version = "0.0.1",
)

bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "googletest", version = "1.14.0")
bazel_dep(name = "highway", version = "1.3.0")
bazel_dep(name = "abseil-cpp", version = "20250814.0", repo_name = "absl")
bazel_dep(name = "eigen", version = "4.0.0-20241125.bcr.2")
bazel_dep(name = "kmeans", version = "0.0.1")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "parlaylib",
    sha256 = "68c062ad116fd49d77651d7a24fb985aa66e8ec9ad05176b6af3ab5d29a16b1f",
    strip_prefix = "parlaylib-bazel/include/",
    urls = ["https://github.com/ParAlg/parlaylib/archive/refs/tags/bazel.tar.gz"],
)

git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "git_repository")

git_repository(
    name = "cpam",
    commit = "049ad573ef5844a7f4e59c92111749df1da7b6ba",
    remote = "https://github.com/ParAlg/CPAM.git",
    strip_prefix = "include/",
)

git_repository(
    name = "parlayann",
    branch = "bazel",
    remote = "https://github.com/cmuparlay/parlayann.git",
)

local_path_override(
    module_name = "kmeans",
    path = "./external/kmeans/",
)

git_repository(
    name = "faiss",
    build_file_content = """
cc_library(
    name = "faiss_core",
    srcs = glob([
        "faiss/**/*.cpp",
    ], exclude = [
        "faiss/gpu/**/*.cpp",
        "faiss/python/**/*.cpp",
    ]),
    hdrs = glob([
        "faiss/**/*.h",
    ], exclude = [
        "faiss/gpu/**/*.h",
        "faiss/python/**/*.h",
    ]),
    includes = ["."],
    copts = ["-fopenmp"],
    linkopts = ["-fopenmp", "-lopenblas"],
    visibility = ["//visibility:public"],
)
""",
    remote = "https://github.com/facebookresearch/faiss.git",
    tag = "v1.11.0",
)
