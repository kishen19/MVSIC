"""Defines the Bazel module for mvsic."""

module(
    name = "mvsic",
    version = "0.0.1",
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_cc", version = "0.2.14")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")
bazel_dep(name = "google_benchmark", version = "1.9.5")
bazel_dep(name = "highway", version = "1.3.0")
bazel_dep(name = "abseil-cpp", version = "20250814.1", repo_name = "com_google_absl")
bazel_dep(name = "eigen", version = "4.0.0-20241125.bcr.2")
bazel_dep(name = "pybind11_bazel", version = "3.0.0")
bazel_dep(name = "rules_python", version = "1.7.0")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")

# System-installed Intel oneAPI MKL.  Exposes only the headers; libraries are
# linked via `linkopts` in cc_binary rules (linker -L paths are allowed to
# reference outside the execution root, but -isystem isn't).  Used by
# //data-tools:compute_ground_truth.
new_local_repository(
    name = "mkl",
    path = "/opt/intel/oneapi/mkl/latest",
    build_file_content = """
package(default_visibility = ["//visibility:public"])

cc_library(
    name = "mkl_headers",
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
)
""",
)

http_archive(
    name = "parlaylib",
    patch_cmds = [
        "find . -name 'BUILD' -o -name 'BUILD.bazel' | xargs -r sed -i '1i load(\"@rules_cc//cc:defs.bzl\", \"cc_binary\", \"cc_library\", \"cc_test\")\\n'",
    ],
    sha256 = "57c177c860c5daaf963fbca9dff9d5172ec73fcdad16a713cc1af6b151c84640",
    strip_prefix = "parlaylib-bzlmod-2025/include/",
    urls = ["https://github.com/ParAlg/parlaylib/archive/refs/tags/bzlmod-2025.tar.gz"],
)

http_archive(
    name = "rabitq",
    build_file_content = """
package(default_visibility = ["//visibility:public"])

cc_library(
    name = "rabitqlib",
    # HEADER FILTER: Include everything EXCEPT the embedded Eigen
    hdrs = glob(
        ["include/**"], 
        exclude = ["include/rabitqlib/third/Eigen/**"]
    ),
    
    # Add 'include' to path so "rabitqlib/..." works
    includes = ["include"],
    
    copts = ["-Ofast", "-march=native", "-fopenmp", "-w"],
    linkopts = ["-fopenmp"],
    
    # DEPENDENCY: Force it to use the external Eigen
    deps = ["@eigen//:eigen"],
)
""",
    # PATCH: Rewrite include paths to use the standard Eigen location,
    # and fix FhtKacRotator to base its size checks on padded_dim (after padding)
    # instead of the original dim. This allows small dims (e.g. D=16) that are
    # padded up to 64 to work with FhtKacRotator.
    patch_cmds = [
        "find include -type f \\( -name '*.hpp' -o -name '*.h' \\) -exec sed -i 's|rabitqlib/third/Eigen/|Eigen/|g' {} +",
        "sed -i 's/size_t bottom_log_dim = floor_log2(dim);/size_t bottom_log_dim = floor_log2(padded_dim);/g' include/rabitqlib/utils/rotator.hpp",
        """python3 - <<'PY'
from pathlib import Path
p = Path("include/rabitqlib/utils/rotator.hpp")
s = p.read_text()
needle = "            case 11:\\n                this->fht_float_ = helper_float_11;\\n                break;\\n"
insert = (
    "            case 11:\\n"
    "                this->fht_float_ = helper_float_11;\\n"
    "                break;\\n"
    "            case 12:\\n"
    "                this->fht_float_ = helper_float_12;\\n"
    "                break;\\n"
    "            case 13:\\n"
    "                this->fht_float_ = helper_float_13;\\n"
    "                break;\\n"
    "            case 14:\\n"
    "                this->fht_float_ = helper_float_14;\\n"
    "                break;\\n"
)
if "case 12:" not in s and needle in s:
    s = s.replace(needle, insert)
    p.write_text(s)
PY""",
    ],
    strip_prefix = "RaBitQ-Library-main",
    urls = ["https://github.com/VectorDB-NTU/RaBitQ-Library/archive/refs/heads/main.zip"],
)

git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "git_repository")

git_repository(
    name = "parlayann",
    branch = "main",
    # Add `inline` to header-defined free functions so they can be included
    # from multiple translation units without violating ODR. Required when
    # bench_search_all instantiations are split across many TUs.
    patch_cmds = [
        "sed -i 's|^float euclidian_distance|inline float euclidian_distance|g' algorithms/utils/euclidian_point.h",
        "sed -i 's|^float mips_distance|inline float mips_distance|g' algorithms/utils/mips_point.h",
    ],
    # remote = "https://github.com/cmuparlay/parlayann.git",
    remote = "https://github.com/kishen19/ParlayANN.git",
)

git_repository(
    name = "kmeans",
    branch = "mvsic",
    # Add `inline` to header-defined free functions for ODR compliance under
    # multi-TU includes. The symmetrize() return type spans two lines, so we
    # insert `inline` on the line above the std::pair<...> declaration.
    patch_cmds = [
        "sed -i 's|^std::pair<parlay::sequence<size_t>,$|inline std::pair<parlay::sequence<size_t>,|' seeding/ksetcover.h",
    ],
    remote = "git@github.com:ParAlg/Parallel-KMeans.git",
)

# python bindings relevant
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.14",
)

bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    commit = "a14ad3a64e7bf398ab48105aaa0348e032ac87f8",
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
)
