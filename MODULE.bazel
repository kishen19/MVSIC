"""Defines the Bazel module for mvsic."""

module(
    name = "mvsic",
    version = "0.0.1",
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_cc", version = "0.2.14")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")
bazel_dep(name = "google_benchmark", version = "1.9.5")
bazel_dep(name = "highway", version = "1.3.0")
bazel_dep(name = "abseil-cpp", version = "20250814.1", repo_name = "com_google_absl")
bazel_dep(name = "eigen", version = "4.0.0-20241125.bcr.2")
bazel_dep(name = "pybind11_bazel", version = "3.0.0")
bazel_dep(name = "rules_python", version = "1.7.0")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")

# System-installed Intel oneAPI MKL.  Exposes only the headers; libraries are
# linked via `linkopts` in cc_binary rules (linker -L paths are allowed to
# reference outside the execution root, but -isystem isn't).  Used by
# //data-tools:compute_ground_truth.
new_local_repository(
    name = "mkl",
    path = "/opt/intel/oneapi/mkl/latest",
    build_file_content = """
package(default_visibility = ["//visibility:public"])

cc_library(
    name = "mkl_headers",
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
)
""",
)

http_archive(
    name = "parlaylib",
    patch_cmds = [
        "find . -name 'BUILD' -o -name 'BUILD.bazel' | xargs -r sed -i '1i load(\"@rules_cc//cc:defs.bzl\", \"cc_binary\", \"cc_library\", \"cc_test\")\\n'",
    ],
    sha256 = "57c177c860c5daaf963fbca9dff9d5172ec73fcdad16a713cc1af6b151c84640",
    strip_prefix = "parlaylib-bzlmod-2025/include/",
    urls = ["https://github.com/ParAlg/parlaylib/archive/refs/tags/bzlmod-2025.tar.gz"],
)

http_archive(
    name = "rabitq",
    build_file_content = """
package(default_visibility = ["//visibility:public"])

cc_library(
    name = "rabitqlib",
    # HEADER FILTER: Include everything EXCEPT the embedded Eigen
    hdrs = glob(
        ["include/**"], 
        exclude = ["include/rabitqlib/third/Eigen/**"]
    ),
    
    # Add 'include' to path so "rabitqlib/..." works
    includes = ["include"],
    
    copts = ["-Ofast", "-march=native", "-fopenmp", "-w"],
    linkopts = ["-fopenmp"],
    
    # DEPENDENCY: Force it to use the external Eigen
    deps = ["@eigen//:eigen"],
)
""",
    # PATCH: Rewrite include paths to use the standard Eigen location,
    # and fix FhtKacRotator to base its size checks on padded_dim (after padding)
    # instead of the original dim. This allows small dims (e.g. D=16) that are
    # padded up to 64 to work with FhtKacRotator.
    patch_cmds = [
        "find include -type f \\( -name '*.hpp' -o -name '*.h' \\) -exec sed -i 's|rabitqlib/third/Eigen/|Eigen/|g' {} +",
        "sed -i 's/size_t bottom_log_dim = floor_log2(dim);/size_t bottom_log_dim = floor_log2(padded_dim);/g' include/rabitqlib/utils/rotator.hpp",
        """python3 - <<'PY'
from pathlib import Path
p = Path("include/rabitqlib/utils/rotator.hpp")
s = p.read_text()
needle = "            case 11:\\n                this->fht_float_ = helper_float_11;\\n                break;\\n"
insert = (
    "            case 11:\\n"
    "                this->fht_float_ = helper_float_11;\\n"
    "                break;\\n"
    "            case 12:\\n"
    "                this->fht_float_ = helper_float_12;\\n"
    "                break;\\n"
    "            case 13:\\n"
    "                this->fht_float_ = helper_float_13;\\n"
    "                break;\\n"
    "            case 14:\\n"
    "                this->fht_float_ = helper_float_14;\\n"
    "                break;\\n"
)
if "case 12:" not in s and needle in s:
    s = s.replace(needle, insert)
    p.write_text(s)
PY""",
    ],
    strip_prefix = "RaBitQ-Library-main",
    urls = ["https://github.com/VectorDB-NTU/RaBitQ-Library/archive/refs/heads/main.zip"],
)

git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "git_repository")

git_repository(
    name = "parlayann",
    branch = "main",
    # Add `inline` to header-defined free functions so they can be included
    # from multiple translation units without violating ODR. Required when
    # bench_search_all instantiations are split across many TUs.
    #
    # Also unconditionally enable the "Pass X% complete" Vamana build
    # progress prints — upstream has them commented out, but we want them
    # so MUVERA / Vamana builds aren't silent during the long graph phase.
    patch_cmds = [
        "sed -i 's|^float euclidian_distance|inline float euclidian_distance|g' algorithms/utils/euclidian_point.h",
        "sed -i 's|^float mips_distance|inline float mips_distance|g' algorithms/utils/mips_point.h",
        "sed -i 's|// std::cout << \"Pass \" << 100 \\* frac << \"% complete\"|std::cout << \"Pass \" << 100 * frac << \"% complete\"|' algorithms/vamana/index.h",
        "sed -i 's|//           << std::endl;|          << std::endl;|' algorithms/vamana/index.h",
    ],
    # remote = "https://github.com/cmuparlay/parlayann.git",
    remote = "https://github.com/kishen19/ParlayANN.git",
)

git_repository(
    name = "kmeans",
    branch = "mvsic",
    # Add `inline` to header-defined free functions for ODR compliance under
    # multi-TU includes. The symmetrize() return type spans two lines, so we
    # insert `inline` on the line above the std::pair<...> declaration.
    patch_cmds = [
        "sed -i 's|^std::pair<parlay::sequence<size_t>,$|inline std::pair<parlay::sequence<size_t>,|' seeding/ksetcover.h",
    ],
    remote = "git@github.com:ParAlg/Parallel-KMeans.git",
)

# GEM (SIGMOD'26 graph-based multi-vector retrieval) source dependency.
#
# We consume *only* the upstream `library` bits — header-only `hnswlib/`
# (with the GEM-specific extensions on top of vanilla hnswlib), `cnpy`
# (for reading the gem_data .npy artifacts), and `otlib` (for the EMD
# distance kernels that `hnswlib/space_l2.h` transitively calls).
#
# Upstream's `example_vecset_search_gem.cpp` is intentionally left out of
# the build graph: it's a single-shot demo with a hardcoded dataset
# selector and a 13 GB `train_query_data` allocation at the top of
# `main()`. Our own runner under //benchmarks/gem lifts the demo's
# `Solution` class body (build_fine_cluster / search_with_fine_cluster /
# load_fine_cluster) into a clean CLI driver, so upstream itself stays
# unmodified and no fork is required.
#
# Public upstream: https://github.com/sigmod26gem/sigmod26gem — pinned to a
# fixed commit for reproducible builds (bump `commit` when you intentionally
# want a newer upstream revision).
git_repository(
    name = "sigmod26gem",
    remote = "https://github.com/sigmod26gem/sigmod26gem",
    commit = "08046af7ad63354378b2db308c50ae87797818d9",
    build_file_content = """
package(default_visibility = ["//visibility:public"])

# cnpy: tiny .npy / .npz reader/writer (header + one .cpp). Used by the
# runner to read the gem_data tree (centroids.npy, encoding<i>_float16.npy,
# doclens<i>.npy, doc_codes_<i>.npy, qembs.npy, ...).
cc_library(
    name = "cnpy",
    srcs = ["hnswlib/cnpy/cnpy.cpp"],
    hdrs = ["hnswlib/cnpy/cnpy.h"],
    includes = ["hnswlib/cnpy"],
    linkopts = ["-lz"],
)

# otlib: Bonneel-style optimal-transport / EMD kernels that
# hnswlib/space_l2.h's L2SqrVecEMD* functions call into. We compile the
# C++ TU (EMD_wrapper.cpp); the .pyx / .py files are Cython/Python and
# ignored by the cc_library glob.
cc_library(
    name = "otlib",
    srcs = ["hnswlib/otlib/EMD_wrapper.cpp"],
    hdrs = [
        "hnswlib/otlib/EMD.h",
        "hnswlib/otlib/core.h",
        "hnswlib/otlib/full_bipartitegraph.h",
        "hnswlib/otlib/network_simplex_simple.h",
    ],
    includes = ["hnswlib/otlib"],
    copts = ["-Ofast", "-march=native", "-w"],
)

# hnswlib: header-only graph index *with the GEM extensions baked in*
# (searchKnnClusterEntries, addClusterPointEntry, entry_map, search_set,
# fast_dot_product_blas, L2SqrVecEMD / L2SqrVecCF / L2SqrVecClusterEMD,
# etc.). Includes Eigen + OpenBLAS via system headers (cblas.h and
# Eigen/Dense are #included from space_l2.h).
cc_library(
    name = "hnswlib",
    hdrs = glob([
        "hnswlib/hnswlib/*.h",
    ]),
    includes = ["hnswlib"],
    copts = ["-Ofast", "-march=native", "-fopenmp", "-w"],
    linkopts = ["-fopenmp", "-lopenblas"],
    deps = [
        ":otlib",
        "@eigen",
    ],
)
""",
)

# Upstream nmslib/hnswlib (flat token HNSW + C++ multi-vector search API).
# Separate from @sigmod26gem's fork (GEM-specific cluster/EMD extensions).
git_repository(
    name = "hnswlib_upstream",
    remote = "https://github.com/nmslib/hnswlib",
    commit = "d9b3608c83d83b46c96e25088cb1d729b29dcfe9",  # v0.9.0
    build_file_content = """
package(default_visibility = ["//visibility:public"])

cc_library(
    name = "hnswlib",
    hdrs = glob(["hnswlib/*.h"]),
    includes = ["."],
    copts = ["-O3", "-march=native", "-w"],
)
""",
)

# python bindings relevant
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.11",
)

bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    commit = "a14ad3a64e7bf398ab48105aaa0348e032ac87f8",
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
)
